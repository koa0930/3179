{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 980,
  "height": 520,
  "projection": {"type": "mercator"},
  "layer": [
    { "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#e6f2ff"} },

    

    { "data": {
        "url": "https://raw.githubusercontent.com/koa0930/3179/main/ne_110m.json",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "#f3f3f3", "stroke": "#bdbdbd"} },

    { "data": {"url": "https://raw.githubusercontent.com/koa0930/3179/main/mine_simple.csv"},
      "transform": [
        {"aggregate": [
            {"op": "count", "as": "mines"},
            {"op": "mean", "field": "longitude", "as": "lon"},
            {"op": "mean", "field": "latitude", "as": "lat"}],
         "groupby": ["country"]},
        {"calculate":
           "datum.mines <= 500 ? '0–500' : datum.mines <= 1000 ? '501–1,000' : datum.mines <= 5000 ? '1,001–5,000' : '5,001+'",
         "as": "mines_bucket"}
      ],
      "mark": {"type": "circle", "opacity": 0.9, "stroke": "#fff", "strokeWidth": 0.5},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "mines_bucket", "type": "ordinal", "title": "Mine count",
          "scale": {"domain": ["0–500","501–1,000","1,001–5,000","5,001+"],
                    "range":  [120, 400, 900, 1600]},
          "legend": {"symbolType": "circle"}
        },
        "color": {
          "field": "mines_bucket", "type": "ordinal", "title": "Mine count",
          "scale": {"domain": ["0–500","501–1,000","1,001–5,000","5,001+"],
                    "range":  ["#fee5d9","#fcae91","#fb6a4a","#a50f15"]}
        },
        "tooltip": [
          {"field": "country", "title": "Country"},
          {"field": "mines", "title": "# of mines"},
          {"field": "mines_bucket", "title": "Class"}
        ]
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}
