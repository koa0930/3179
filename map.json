{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 980,
  "height": 520,
  "projection": {"type": "mercator"},
  "title": {"text": "Global Mine Distribution by Country", "fontSize": 22},
  "data": {
    "url": "https://raw.githubusercontent.com/koa0930/3179/main/ne_110m.json",
    "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
  },
  "transform": [
    {
      "lookup": "properties.NAME",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/koa0930/3179/main/mine_simple.csv"
        },
        "transform": [
          {"aggregate": [{"op": "count", "as": "mines"}], "groupby": ["country"]}
        ],
        "key": "country",
        "fields": ["mines"]
      }
    },
    {"calculate": "isValid(datum.mines) ? datum.mines : 0", "as": "mines"},
    {
      "calculate": "datum.mines < 100 ? '0–99' : datum.mines < 500 ? '100–499' : datum.mines < 1000 ? '500–999' : datum.mines < 10000 ? '1k–9,999' : '10k+'",
      "as": "mine_class"
    }
  ],
  "mark": {"type": "geoshape", "stroke": "#999"},
  "encoding": {
    "color": {
      "field": "mine_class",
      "type": "ordinal",
      "title": "Mine count (class)",
      "scale": {
        "domain": ["0–99", "100–499", "500–999", "1k–9,999", "10k+"],
        "range": ["#fee5d9", "#fcae91", "#fb6a4a", "#de2d26", "#a50f15"]
      }
    },
    "tooltip": [
      {"field": "properties.NAME", "title": "Country"},
      {"field": "mines", "title": "# of mines"},
      {"field": "mine_class", "title": "Class"}
    ]
  }
}
