{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Global total mineral production by continent (1984–2023).",
  "title": {"text": "Mineral Production by Continent (1984–2023)", "fontWeight": "bold"},
  "height": 420,
  "width": 700,

  "data": {
    "url": "https://raw.githubusercontent.com/koa0930/3179/main/data/Total_World_Production.csv"
  },

  "transform": [
    { "filter": "datum.Continents && datum.Continents !== 'Total'" },
    {
      "fold": [
        "1984","1985","1986","1987","1988","1989","1990","1991","1992","1993",
        "1994","1995","1996","1997","1998","1999","2000","2001","2002","2003",
        "2004","2005","2006","2007","2008","2009","2010","2011","2012","2013",
        "2014","2015","2016","2017","2018","2019","2020","2021","2022","2023"
      ],
      "as": ["year","production_mt"]
    },
    { "calculate": "toNumber(datum.year)", "as": "year_num" },
    { "calculate": "toNumber(datum.production_mt)", "as": "production_mt_num" }
  ],

  "mark": { "type": "area", "interpolate": "monotone" },

  "encoding": {
    "x": {
      "field": "year_num",
      "type": "quantitative",
      "title": "Year",
      "axis": {
        "values": [
          1984,1985,1986,1987,1988,1989,1990,1991,1992,1993,
          1994,1995,1996,1997,1998,1999,2000,2001,2002,2003,
          2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,
          2014,2015,2016,2017,2018,2019,2020,2021,2022,2023
        ],
        "labelAngle": -45,         
        "labelAlign": "right",     
        "labelBaseline": "top",     
        "labelPadding": 6,          
        "labelOverlap": false,
        "labelFontSize": 10
      },
      "scale": { "nice": false }
    },
    "y": {
      "aggregate": "sum",
      "field": "production_mt_num",
      "type": "quantitative",
      "title": "Total Production (t)",
      "axis": { "format": "~s" }
    },
    "color": {
      "field": "Continents",
      "type": "nominal",
      "title": "Continent",
      "scale": { "scheme": "tableau10" },
      "legend": { "orient": "right" }
    },
    "tooltip": [
      { "field": "Continents", "type": "nominal", "title": "Continent" },
      { "field": "year_num", "type": "quantitative", "title": "Year", "format": "d" },
      { "field": "production_mt_num", "type": "quantitative", "title": "Production (t)", "format": ",.0f" }
    ]
  },

  "config": {
    "view": { "stroke": null },
    "axis": { "titleFontSize": 13 }
  }
}
