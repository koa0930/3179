{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Mine Output by Year (2000–2020)",
  "data": {
    "url": "https://raw.githubusercontent.com/koa0930/3179/main/mine_output.csv"
  },
  "vconcat": [
    {
      "height": 320,
      "transform": [{ "filter": { "param": "brush" } }],
      "mark": { "type": "bar" },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": { "title": "Year", "labelAngle": 0 }
        },
        "y": {
          "aggregate": "sum",
          "field": "value_tonnes",
          "type": "quantitative",
          "title": "Output (tonnes)"
        },
        "color": {
          "field": "material",
          "type": "nominal",
          "legend": { "title": "Material" },
          "scale": {
            "domain": ["Copper", "Gold", "Silver"],
            "range": ["#B87333", "#FFD700", "#B0B0B0"]
          }
        },
        "tooltip": [
          { "field": "year", "type": "ordinal", "title": "Year" },
          { "field": "material", "type": "nominal", "title": "Material" },
          {
            "aggregate": "sum",
            "field": "value_tonnes",
            "type": "quantitative",
            "title": "Tonnes"
          }
        ]
      }
    },
    {
      "height": 90,
      "mark": { "type": "area" },
      "params": [
        { "name": "brush", "select": { "type": "interval", "encodings": ["x"] } }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": { "title": null, "labelAngle": 0 }
        },
        "y": {
          "aggregate": "sum",
          "field": "value_tonnes",
          "type": "quantitative",
          "title": "Total (t)"
        },
        "color": { "value": "#bbb" }
      }
    }
  ],
  "width": 800,
  "config": {
    "axis": { "grid": true },
    "bar": { "cornerRadiusTopLeft": 2, "cornerRadiusTopRight": 2 }
  }
}
