{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Global total mineral production by continent, 1984–2023.",
  "title": {"text": "Global Mineral Production by Continent (1984–2023)", "fontWeight": "bold"},
  "width": "container",
  "height": 420,
  "data": {"url": "data/Total_World_Production.csv"},
  "mark": {"type": "area", "interpolate": "monotone"},
  "encoding": {
    "x": {"field": "year", "type": "ordinal", "title": "Year"},
    "y": {
      "aggregate": "sum",
      "field": "production_mt",
      "type": "quantitative",
      "title": "Total Production (t)",
      "axis": {"format": "~s"}
    },
    "color": {
      "field": "continent",
      "type": "nominal",
      "title": "Continent",
      "scale": {"scheme": "tableau10"}
    },
    "tooltip": [
      {"field": "continent", "type": "nominal"},
      {"field": "year", "type": "ordinal"},
      {"field": "production_mt", "type": "quantitative", "title": "Production (t)", "format": ",.0f"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 13}
  }
}
