{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Top 10 countries by count for the selected commodity",

  "width": 1100,
  "height": 520,
  "padding": { "top": 30, "right": 100, "left": 5, "bottom": 5 },

  "data": { "url": "https://raw.githubusercontent.com/koa0930/3179/main/mine_simple.csv" },

  "params": [
    {
      "name": "pCommodity",
      "value": "Gold",
      "bind": {
        "input": "select",
        "name": "Commodity: ",
        "options": ["Gold", "Copper", "Silver", "Lead", "Iron"]
      }
    }
  ],

  "transform": [
    { "filter": "isValid(datum.country) && datum.country != ''" },
    { "filter": "isValid(datum.commod1) && datum.commod1 != ''" },
    { "calculate": "split(replace(datum.commod1,' ', ''), ',')", "as": "commods" },
    { "flatten": ["commods"] },
    { "calculate": "datum.commods", "as": "commodity" },
    { "filter": "datum.commodity == pCommodity" },
    { "aggregate": [{ "op": "count", "as": "sites" }], "groupby": ["country", "commodity"] },
    { "window": [{ "op": "rank", "as": "r" }], "sort": [{ "field": "sites", "order": "descending" }] },
    { "filter": "datum.r <= 10" }
  ],

  "layer": [
    {
      "mark": "bar",
      "encoding": {
        "x": { "field": "sites", "type": "quantitative", "title": "Sites" },
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": { "field": "sites", "order": "descending" },
          "scale": { "reverse": true },
          "title": null
        },
        "color": {
          "field": "commodity",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": ["Gold", "Copper", "Silver", "Lead", "Iron"],
            "range": ["#FFC107", "#C14D36", "#BFC3C7", "#7A7E83", "#4A4E54"]
          }
        },
        "tooltip": [
          { "field": "country", "title": "Country" },
          { "field": "sites", "title": "Sites", "format": "," },
          { "field": "commodity", "title": "Commodity" }
        ]
      }
    },

    {
      "transform": [{ "filter": "datum.r == 1" }],
      "mark": { "type": "text", "align": "left", "dx": 8, "fontWeight": "bold" },
      "encoding": {
        "x": { "field": "sites", "type": "quantitative" },
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": { "field": "sites", "order": "descending" },
          "scale": { "reverse": true }
        },
        "text": { "field": "sites", "format": "," }
      }
    },

    {
      "transform": [
        { "aggregate": [{ "op": "mean", "field": "sites", "as": "mean_sites" }] }
      ],
      "mark": { "type": "rule", "color": "#FF1744", "size": 3 },
      "encoding": {
        "x": { "field": "mean_sites", "type": "quantitative" }
      }
    },

    {
      "transform": [
        { "aggregate": [{ "op": "mean", "field": "sites", "as": "mean_sites" }] },
        { "calculate": "'Mean: ' + format(datum.mean_sites, ',.0f')", "as": "mean_label" }
      ],
      "mark": { "type": "text", "align": "left", "dx": 6, "dy": -8, "color": "#FF1744", "fontWeight": "bold" },
      "encoding": {
        "x": { "field": "mean_sites", "type": "quantitative" },
        "y": { "value": -10 },
        "text": { "field": "mean_label" }
      }
    }
  ]
}
